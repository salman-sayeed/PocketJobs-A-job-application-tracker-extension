{
  "manifest_version": 3,
  "name": "PocketJobs",
  "version": "1.0",
  "description": "A Job Application Tracker",
  "action": {
    "default_popup": "./popup/popup.html",
    "default_icon": {
      "16": "./icons/icon16.png",
      "32": "./icons/icon32.png",
      "48": "./icons/icon48.png",
      "128": "./icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "./popup/background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting"]
}
